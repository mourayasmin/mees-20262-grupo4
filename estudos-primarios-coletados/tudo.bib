@ARTICLE{Krumsvik2024172,
	author = {Krumsvik, Rune Johan},
	title = {Artificial intelligence in nurse education – a new sparring partner? GPT-4 capabilities of formative and summative assessment in National Examination in Anatomy, Physiology, and Biochemistry},
	year = {2024},
	journal = {Nordic Journal of Digital Literacy},
	volume = {19},
	number = {3},
	pages = {172 - 186},
