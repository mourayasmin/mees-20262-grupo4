	title = {A No-Code Approach for the Teacher as Developer of AI-Powered Academic Vocabulary Applications},
	year = {2026},
	journal = {2026 11th International Conference on Distance Education and Learning, ICDEL 2026},
	pages = {526 - 531},
	doi = {10.1109/ICDEL70250.2026.11663903},
	url = {https://www.scopus.com/pages/publications/105050665754?origin=resultslist},
	affiliations = {School of Basic Education, National University of Defense Technology, Changsha, China; Faculty of Arts and Humanities, University of Macau, Macau, Macao},
	abstract = {While Mobile-Assisted Language Learning (MALL) has transformed vocabulary learning methods, generic applications often lack the discipline-specific contexts and depth required for high-level scholarly communication. This paper presents AcaVoca Buddy, a specialized Socratic tutor developed through a three-phase teacher-as-developer framework using a generative AI-driven, no-code platform. The development process involved: (1) decomposing pedagogical logic into programmable tasks; (2) instantiating these constructs through an AI-powered cognitive engine; and (3) iteratively refining the user experience to support autonomous mastery. By leveraging a no-code approach, this study translates complex instructional design directly into a personalized application to facilitate academic vocabulary mastery. This paper offers a practical road map for educator-developers, illustrating how no-code platforms democratize educational technology and empower teachers to shift from passive consumers to active creators of pedagogical tools.  © 2026 IEEE.},
	author_keywords = {citizen development; mobile-assisted language learning; no-code platforms; vibe coding; vocabulary application},
	keywords = {Computer aided instruction; Computer programming languages; E-learning; Education computing; Educational technology; Engineering education; Learning systems; Teaching; User experience; Academic vocabularies; Citizen development; Learning methods; Mobile assisted language learning; No-code platform; Scholarly communication; Teachers'; Vibe coding; Vocabulary application; Vocabulary learning; Codes (symbols)},
