@CONFERENCE{Lin202694,
	author = {Lin, Meng-Wei and Hung, Chih-Cheng},
	title = {Learning Motivation and Achievement in AISupported Project-Based Learning: A Comparison of a Pedagogical AI Agent and ChatGPT},
	year = {2026},
	journal = {2026 14th International Conference on Information and Education Technology, ICIET 2026},
	pages = {94 - 98},
	doi = {10.1109/ICIET69664.2026.11561693},
	url = {https://www.scopus.com/pages/publications/105043630513?origin=resultslist},
	affiliations = {Asia University, Department of Foreign Languages and Literature, Taichung City, Taiwan; National Chung Cheng University, Center for Teacher Education, Chiayi City, Taiwan},
	abstract = {This study investigates the differential effects of two generative AI-supported collaborative learning conditions on university students' Learning Motivation and Attitude (LMA) and Achievement of Learning Objectives (ALO) within a projectbased learning (PBL) environment: An instructor-designed pedagogical AI agent and the general-purpose ChatGPT model. Using repeated-measures ANOVA across three time points (pre-, mid-, and post-intervention), results showed that the AI agent group demonstrated statistically significant and sustained improvements in both LMA and ALO, with large effect sizes and early stabilization across the PBL cycle. In contrast, the ChatGPT group exhibited limited and nonsignificant changes in LMA, alongside a nonlinear but significant improvement in ALO, with gains emerging primarily at the post-intervention stage. Pairwise analyses indicated that the AI agent's structured scaffolding and pedagogically aligned interaction design supported more consistent growth, particularly during phases of increasing collaborative complexity. Overall, the findings suggest that while general-purpose LLMs can facilitate late-stage performance gains, purpose-built AI agents provide more reliable support for motivational stability and learning progression. The study underscores the importance of instructional alignment and adaptive scaffolding in the design of educational AI systems.  © 2026 IEEE.},
	author_keywords = {AI pedagogical agents; computer-assisted collaborative learning; learning motivation; project-based learning},
	keywords = {Artificial intelligence; Collaborative learning; Computer aided instruction; Distributed computer systems; E-learning; Federated learning; Intelligent agents; Stabilization; Teaching; AI pedagogical agent; Attitudes and achievements; Collaborative learning; Computer assisted; Computer-assisted collaborative learning; Learning attitudes; Learning motivation; Learning objectives; Pedagogical agents; Project based learning; Motivation},
	correspondence_address = {M.-W. Lin; Asia University, Department of Foreign Languages and Literature, Taichung City, Taiwan; email: mavise.lin@asia.edu.tw},
	publisher = {Institute of Electrical and Electronics Engineers Inc.},
	isbn = {979-833154552-9},
