	title = {Twin Minds in Code Education: Simulating Student-Tutor Dynamics using LLMs as Cognitive Digital Twins},
	year = {2026},
	journal = {23rd International Learning and Technology Conference: Twin Minds: Agentic AI and the New Era of Autonomy, L and T 2026 - Proceedings},
