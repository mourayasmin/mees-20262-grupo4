	title = {A Socratic AI Tutoring System for Reflective and Adaptive Learning Using Offline LLMs and Machine Learning Models},
	year = {2026},
	journal = {Proceedings of International Conference on Next-Gen Quantum and Advanced Computing: Algorithms, Security, and Beyond, NQComp 2026},
	pages = {336 - 342},
