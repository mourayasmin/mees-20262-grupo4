@ARTICLE{Etkin2025,
	author = {Etkin, Hudson K. and Etkin, Kai J. and Carter, Ryan J. and Rolle, Camarin E.},
	title = {Differential effects of GPT-based tools on comprehension of standardized passages},
	year = {2025},
	journal = {Frontiers in Education},
	volume = {10},
	pages = {},
	doi = {10.3389/feduc.2025.1506752},
