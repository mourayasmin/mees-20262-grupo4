@CONFERENCE{Pal Chowdhury20245,
	author = {Pal Chowdhury, Sankalan and Zouhar, Vilém and Sachan, Mrinmaya},
	title = {AutoTutor meets Large Language Models: A Language Model Tutor with Rich Pedagogy and Guardrails},
	year = {2024},
	journal = {L@S 2024 - Proceedings of the 11th ACM Conference on Learning @ Scale},
	pages = {5 - 15},
	doi = {10.1145/3657604.3662041},
