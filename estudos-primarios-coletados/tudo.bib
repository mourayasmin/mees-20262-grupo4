	author = {Cutillas, Anesito L. and Balili, Enrique E. and Rellin, Evangeline C. and Remo, Mariel H. and Quindala, Estrella S. and Bacalso, Fritz D.},
	title = {Analyzing alternative academic assessments (AAAs) in universities with cheat-proofing behaviors and instructor-formulated mechanics in an AI-dependent setting},
	year = {2025},
