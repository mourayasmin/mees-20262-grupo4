	author = {Raj, Joel and Muppa, Ashwath and Vora, Raj and Saini, Ansh and Boicu, Mihai},
	title = {Developing a Socratic Evaluation Software Using Argumentation and Graph-Based Open Student Modeling},
	year = {2025},
	journal = {2025 IEEE MIT Undergraduate Research Technology Conference, URTC 2025 - Conference Proceedings},
	pages = {},
