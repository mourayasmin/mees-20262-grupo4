@ARTICLE{Olivier2026216,
	author = {Olivier, Corna and Weilbach, Lizette},
	title = {Using a GenAI Chatbot to Facilitate Personalized Learning: a Case Study in Online Higher Education},
	year = {2026},
	journal = {Communications in Computer and Information Science},
	volume = {2787 CCIS},
	pages = {216 - 227},
	doi = {10.1007/978-3-032-15463-7_18},
	url = {https://www.scopus.com/pages/publications/105030337401?origin=resultslist},
	affiliations = {University of Pretoria, Pretoria, South Africa},
	abstract = {The integration of Generative AI (GenAI) chatbots in education is transforming personalized learning, yet their effectiveness in online distance learning remains underexplored. This study investigates how a GenAI chatbot tutor facilitates personalized learning in an online higher education setting, using the Community of Inquiry (CoI) framework. A qualitative case study approach was adopted, analyzing chat logs, chatbot platform analytics, and a semi-structured interview. The study included four voluntary participants who engaged with the chatbot as a learning support tool, while one participant was interviewed to provide deeper insights. Findings indicate that the chatbot contributed to cognitive presence by scaffolding inquiry and promoting adaptive knowledge construction, social presence by enhancing engagement and fostering an inclusive learning space, and teaching presence through context-aware responses and real-time learning insights. However, technological constraints, inconsistent response accuracy, and limited handling of complex queries were identified as challenges. These results suggest that while GenAI chatbots enhance personalized learning, they should be integrated as supplementary tools rather than standalone tutors. Ethical considerations, including data privacy, transparency, and AI reliability, must also be addressed. Future research should focus on refining AI-generated responses, investigating long-term learning outcomes, and optimizing human-AI collaboration in education. © The Author(s), under exclusive license to Springer Nature Switzerland AG 2026.},
	author_keywords = {Community of Inquiry (CoI); GenAI chatbot tutor; Generative AI in Education (GenAIED); higher education; Intelligent Tutoring Systems (ITS); online distance learning; Personalized learning},
	keywords = {Computer aided instruction; Data privacy; E-learning; Education computing; Federated learning; Learning systems; Teaching; Chatbots; Community of inquiry; Generative AI chatbot tutor; Generative AI in education; High educations; Intelligent tutoring; Intelligent tutoring system; Online distance learning; Personalized learning; Tutoring system; Online systems},
