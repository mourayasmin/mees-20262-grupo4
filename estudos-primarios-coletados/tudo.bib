@ARTICLE{Hidalgo2026,
	author = {Hidalgo, Luciano and Pérez Sanagustín, Mar and Nascimento, Andre and Munoz–Gama, Jorge},
	title = {How does conversation unfold? analyzing learner–LLM dialogues through multiple analytical lenses},
	year = {2026},
	journal = {Interactive Learning Environments},
	pages = {},
	doi = {10.1080/10494820.2026.2739434},
	url = {https://www.scopus.com/pages/publications/105052975045?origin=resultslist},
	affiliations = {Department of Computer Science, Pontificia Universidad Católica de Chile, Santiago, Chile; Universite de Toulouse, Institut de Recherche en Informatique de Toulouse, Toulouse, France; Department of Computing, Universidade Federal Rural de Pernambuco, Recife, Brazil},
	abstract = {As Large Language Models increasingly permeate educational scenarios, understanding the dynamics of learner-LLM collaboration has become a priority for learning analytics research. Existing approaches, however, tend to rely on surface-level metrics or single perspective coding schemes, limiting insight into the multifaceted nature of these exchanges. This study introduces an analytical framework that combines three theoretically grounded coding schemes with process mining techniques to analyze learner-LLM collaboration in a metacognitive learning task. We applied the framework to 159 conversations from 78 higher education students interacting with a Socratic LLM-based chatbot deployed in a Thermodynamics course, identifying patterns in dialogue structure, epistemic contribution, and conversational balance. For each coding scheme, cluster analysis identified distinct interaction profiles, capturing meaningful variability beneath aggregate patterns. Results reveal that dialogue was structurally dominated by the LLM, yet epistemic contributions were similar in proportion between agents despite pronounced asymmetry in utterance volume. Cross-scheme comparison showed that the three schemes produced related but non-equivalent partitions, each capturing a complementary dimension of the same conversations. Furthermore, learners and the LLM assumed clearly differentiated interactive roles, consistent with a tutor-student dynamic. These findings illustrate the value of multi-perspective, process-oriented frameworks for studying learner-LLM dialogues. © 2026 Informa UK Limited, trading as Taylor & Francis Group.},
	author_keywords = {coding schemes; educational dialogue analysis; Intelligent tutoring systems; process mining},
	correspondence_address = {M. Pérez Sanagustín; Universite de Toulouse, Institut de Recherche en Informatique de Toulouse, Toulouse, France; email: mar.perez-sanagustin@irit.fr},
	publisher = {Routledge},
	issn = {10494820},
	language = {English},
	abbrev_source_title = {Interact. Learn. Environ.},
	type = {Article},
	publication_stage = {Article in press},
