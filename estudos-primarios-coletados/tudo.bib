	note = {Cited by: 0; All Open Access; Gold Open Access}
}

@CONFERENCE{Chiang202699,
	author = {Chiang, Yu-Chen and Chang, Chia-Jung},
	title = {Investigating the Effects of Multi AI Agents on Students' Programming Problem-Solving, Cognitive Load, and Learning Performance},
	year = {2026},
	journal = {2026 14th International Conference on Information and Education Technology, ICIET 2026},
	pages = {99 - 103},
	doi = {10.1109/ICIET69664.2026.11561654},
	url = {https://www.scopus.com/pages/publications/105043643145?origin=resultslist},
	affiliations = {Yuan Ze University, Dept. of Information Communication, Taoyuan, Taiwan},
	abstract = {Novice programmers often experience excessive cognitive load and frustration due to insufficient problem-solving strategies and debugging skills. While Generative AI can rapidly provide solutions, the lack of guidance on the learning process hinders the development of students' metacognition. To address these issues, this study developed an interactive learning system integrating Live2D avatars and multiple AI agents. The system aims to resolve two core problems: cognitive overload caused by the lack of procedural guidance in general AI, and learning anxiety resulting from the lack of emotional support in text-based interfaces. The system employs multi-agent architecture - specifically Instructional, Conceptual Scaffolding, Debugger, and Concept Reinforcement Agents - to decompose complex tasks and provide technical scaffolding. Simultaneously, it utilizes Live2D technology to construct a visualized anthropomorphic tutor, establishing social presence to provide emotional support. This pilot study adopted a one-group pretest-posttest design involving 15 university students. The results indicate that after the intervention, students' programming test scores significantly improved, while mental load and mental effort significantly decreased. Furthermore, self-efficacy was substantially enhanced. The data confirms that the dual mechanism of cognitive decomposition and emotional companionship effectively transforms AI from a mere tool into a cognitive partner that facilitates deep learning.  © 2026 IEEE.},
	author_keywords = {anthropomorphic agents; cognitive load; multi-AI agents; pilot study; Programming education; self-efficacy},
	keywords = {Cognitive systems; Computer aided instruction; Deep learning; Education computing; Educational technology; Engineering education; Intelligent agents; Learning systems; Problem solving; Scaffolds; Software testing; Students; Anthropomorphic agent; Cognitive learning; Cognitive loads; Emotional supports; Multi-AI agent; Pilot studies; Problem-solving; Programming education; Programming problem; Self efficacy; Multi agent systems},
	correspondence_address = {Y.-C. Chiang; Yuan Ze University, Dept. of Information Communication, Taoyuan, Taiwan; email: ellis89941999@gmail.com},
	publisher = {Institute of Electrical and Electronics Engineers Inc.},
	isbn = {979-833154552-9},
