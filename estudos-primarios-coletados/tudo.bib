	doi = {10.1109/TLT.2026.3688630},
	url = {https://www.scopus.com/pages/publications/105038432335?origin=resultslist},
	affiliations = {Northeast Normal University, School of Media Science (Journalism), Changchun, 130024, China; Northeast Normal University, School of Information Science and Technology, Changchun, 130024, China; Changchun Humanities and Sciences College, Changchun, 130118, China; Northeast Normal University, School of Physics, Changchun, 130024, China},
	abstract = {Large language models (LLMs) have emerged as a transformative force in educational informatization, offering unprecedented capabilities to simulate teacher-student interactions and generate adaptive instructional resources. However, general-purpose LLMs often provide direct outcome-oriented responses that lack pedagogical sensitivity, while existing educational models frequently prioritize rigid logical inquiry (e.g., Socratic questioning) over the affective and cognitive needs of novice learners. Such limitations can induce learning anxiety and impede the development of student confidence, particularly at the primary education level. To bridge this gap, we propose ConfuciusLM, a specialized educational LLM fine-tuned on a novel instructional dialogue dataset grounded in Confucian pedagogical philosophy. ConfuciusLM embodies a learner-centered paradigm by implementing a heuristic reasoning framework that integrates cognitive guidance with affective support and motivational scaffolding. Through both automated metrics and human-centered pedagogical evaluations, we demonstrate that ConfuciusLM exhibits superior performance compared to open-source LLMs of similar parameter scales in fostering positive learning dispositions and maintaining instructional coherence. This study advances the field of LLM-empowered education by proposing a robust framework that integrates Eastern pedagogical principles with artificial-intelligence-driven instructional design, thereby informing the development of more inclusive, empathetic, and human-centered intelligent tutoring systems. Importantly, the proposed approach offers concrete pedagogical and design implications for primary education, supporting the creation of learning environments that are psychologically safe, conducive to the development of self-efficacy, and capable of sustaining learner engagement under appropriate teacher guidance.  © 2008-2011 IEEE.},
	author_keywords = {Confucian pedagogy; educational large language models (LLMs); instructional dialogue dataset; primary education},
	keywords = {Computer aided instruction; Education computing; Large datasets; Learning systems; Teaching; Confucian pedagogy; Confucians; Educational large language model; Informatization; Instructional dialog dataset; Language model; Personalized instruction; Primary education; Student interactions; Teachers'; Students},
