@CONFERENCE{Wlodarski20261078,
	author = {Wlodarski, Rafal},
	title = {From Domain Understanding to Design Readiness: a playbook for GenAI-supported learning in Software Engineering},
	year = {2026},
	journal = {FSE Companion 2026 - Proceedings of the 34th ACM International Conference on the Foundations of Software Engineering},
	pages = {1078 - 1088},
