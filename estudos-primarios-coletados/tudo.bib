@CONFERENCE{Ashrafi2026,
	author = {Ashrafi, Nazmus Saqueeb and Mediani, Mohammed and Bouktif, Salah},
	title = {LEOPARD: A Structured LLM Orchestration Framework for Precision-Centric Grammatical Error Correction},
	year = {2026},
	journal = {2026 International Conference on Frontiers of Engineering and Emerging Technologies, FET 2026},
	pages = {},
	doi = {10.1109/FET68771.2026.11601896},
	url = {https://www.scopus.com/pages/publications/105046137537?origin=resultslist},
	affiliations = {United Arab Emirates University, Department of Computer Science and Software Engineering, Al Ain, United Arab Emirates},
	abstract = {The application of Large Language Models (LLMs) to Grammatical Error Correction (GEC) is fundamental to Computer-Assisted Language Learning (CALL), where the primary goal is to provide non-native learners with grammatically faithful edits. However, LLMs often fail as pedagogical tools due to a "Fluency Paradox": rather than identifying and fixing specific errors, they prioritize stylistic regeneration over minimal intervention. This tendency leads models to perform a wholesale restructuring of student attempts - transforming valid but non-native phrasing into professional L1-grade English. Such over-correction is pedagogically counterproductive; it conflates stylistic preference with grammatical error, erases the learner's original intent, and obscures the specific proficiency gaps required for targeted instruction. Despite the rapid advancement of LLMs, this tension between creative fluency and diagnostic precision remains largely unaddressed in current GEC literature. In this work, we introduce LEOPARD (LLM Orchestration for Precision-Aware Repair & Diagnosis), a multi-agent framework designed to enforce precision in GEC. LEOPARD employs a deterministic bottleneck architecture where a high-creativity "Boss Agent"proposes corrections, while a precision-focused "Purist Agent"acts as a grammatical guardrail, vetoing unnecessary stylistic edits to preserve the learner's original voice. We demonstrate that this architecture improves the F<sub>0.5</sub> score by 14.6% over a zero-shot GPT-4 baseline on the CLC-FCE benchmark. Our findings suggest that decoupling generative capability from verification logic is essential for recovering the precision needed to deploy trustworthy and helpful AI tutors. © 2026 IEEE.},
	author_keywords = {Computer-Assisted Language Learning (CALL); Grammatical Error Correction (GEC); Hallucination Mitigation; Language Tutoring Systems; Large Language Models (LLM); Multi-Agent Systems (MAS)},
	keywords = {Computational grammars; Computer aided instruction; E-learning; Education computing; Intelligent agents; Learning systems; Multi agent systems; Teaching; Computer assisted language learning; Computer-assisted language learning; Errors correction; Grammatical error correction; Grammatical errors; Hallucination mitigation; Language model; Language tutoring system; Large language model; Multi-agent system; Multiagent systems (MASs); Tutoring system; Error correction},
	correspondence_address = {N.S. Ashrafi; United Arab Emirates University, Department of Computer Science and Software Engineering, Al Ain, United Arab Emirates; email: nazmus.ashrafi@uaeu.ac.ae},
