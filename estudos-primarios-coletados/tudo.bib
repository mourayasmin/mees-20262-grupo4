@CONFERENCE{Yugopuspito2026575,
	author = {Yugopuspito, Pujianto and Lukas, Samuel and Pangaribuan, Julinda Esra Flora},
	title = {Enhancing Cognitive Apprenticeship Through Generative AI: An Empirical Study of Student Perceptions and Learning Outcomes},
	year = {2026},
	journal = {AICCC 2025 - 2025 8th Artificial Intelligence and Cloud Computing Conference},
	pages = {575 - 583},
	doi = {10.1145/3789982.3790056},
	url = {https://www.scopus.com/pages/publications/105039856683?origin=resultslist},
	affiliations = {Graduate Informatics Program, Universitas Pelita Harapan, DKI Jakarta, Jakarta, Indonesia; Graduate Educational Technology Program, Universitas Pelita Harapan, DKI Jakarta, Jakarta, Indonesia; Universitas Pelita Harapan, Banten, Tangerang, Indonesia},
	abstract = {This study explores the integration of Generative Artificial Intelligence (Gen AI) tools into cognitive apprenticeship-based courses and examines their impact on learner experience, engagement, and competence development. Using survey responses from 71 participants across various educational backgrounds, this research evaluates learners' perceptions of AI-driven tutoring systems, personalized content delivery, automated testing, and scaffolding strategies. The study employed validated instruments measuring eight variables: modeling, coaching, scaffolding, articulation, reflection, exploration, learning outcomes with autonomy, and GenAI effectiveness. Multilinear regression analysis was conducted to examine relationships between independent and dependent variables, while demographic analysis explored variations across student populations. Key findings reveal substantial positive relationships between AI-enhanced cognitive apprenticeship components and student learning processes. Scaffolding emerged as the most influential pedagogical mechanism, demonstrating AI's particular strength in providing adaptive, graduated support that promotes student independence. Articulation proved to be the strongest predictor of learning outcomes with autonomy development, highlighting the importance of AI tools that encourage reflective thinking and verbal reasoning. Students who engaged in exploratory interactions with AI tools developed the most favorable perceptions of their educational utility. Demographic analysis revealed that graduate students showed greater appreciation for AI modeling capabilities, while science and engineering students demonstrated higher receptivity to AI scaffolding and reflection tools compared to students from other disciplines. However, limitations such as over-reliance on AI, accuracy concerns, and ethical implications are also identified. The study concludes that GenAI can effectively enhance cognitive apprenticeship-based learning by providing scalable, adaptive, and personalized support that complements rather than replaces traditional mentorship approaches. The research provides empirical foundation for responsible AI implementation in higher education while preserving the essential interpersonal elements and pedagogical integrity of cognitive apprenticeship frameworks.  © 2025 Copyright held by the owner/author(s).},
	author_keywords = {Cognitive Apprenticeship; Education Technology; Generative Artificial Intelligence; Learning Outcomes; Student Perceptions},
	keywords = {Apprentices; Artificial intelligence; Computer aided instruction; Curricula; E-learning; Education computing; Educational technology; Engineering education; Learning systems; Population statistics; Regression analysis; Scaffolds; Teaching; Artificial intelligence tools; Cognitive apprenticeship; Competence development; Education technology; Empirical studies; Generative artificial intelligence; Learner's experience; Learning outcome; Student learning; Student perceptions; Students},
