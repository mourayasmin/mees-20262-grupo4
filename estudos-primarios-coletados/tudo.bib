	title = {STUDENTS’ PERCEPTIONS OF AI-SUPPORTED LANGUAGE LEARNING AND DIGITAL LITERACY: A THAI UNIVERSITY CASE STUDY},
	year = {2026},
	journal = {Studies in Linguistics, Culture and FLT},
	volume = {13},
