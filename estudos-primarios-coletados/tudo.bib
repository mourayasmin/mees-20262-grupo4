	isbn = {979-889176390-6},
	language = {English},
	abbrev_source_title = {Proc. Annu. Meet. Assoc. Comput Linguist.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0; All Open Access; Hybrid Gold Open Access}
