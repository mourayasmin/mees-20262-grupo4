@CONFERENCE{Zeinalipour2026144,
	author = {Zeinalipour, Kamyar and Sadeghi, Amir and Angelini, Giovanni and Rigutini, Leonardo and Gori, Marco and Maggini, Marco},
	title = {MultiHint-9K: Orchestrating Human and AI Agency for Scalable Pedagogical Hint Generation},
	year = {2026},
	journal = {CEUR Workshop Proceedings},
	volume = {4248},
	pages = {144 - 150},
	url = {https://www.scopus.com/pages/publications/105048906496?origin=resultslist},
	affiliations = {University of Siena, Siena, Italy; Expert.ai, Modena, Italy},
	abstract = {Large Language Models offer transformative potential for personalized learning, yet they frequently fail at pedagogical scaffolding-leaking answers or using circular reasoning when generating hints. We present a framework that orchestrates human and AI agency to produce high-fidelity multilingual Socratic hints at scale. Human annotators define quality standards and calibrate automated critics; autonomous AI agents then enforce these standards through adversarial generation, critique, refinement, and recovery loops. This division of agency-humans set the rubric, AI operates at scale-produces MultiHint-9K: a dataset of 9,987 machine-verified, human-calibrated QA-Hint tuples across English, Italian, and Farsi, with a 97.5% yield rate. The pipeline's adversarial critics flagged 5,743 errors across generation attempts, including 3,131 circular reasoning and 495 answer leakage instances. We fine-tune five open-source models (7B-24B) via LoRA, achieving ∼67% ROUGE-L improvement over base models (all p < 0.001), with the largest gains in low-resource Farsi (∼97% ROUGE-L). A component contribution analysis demonstrates that removing any pipeline stage degrades yield from 98% to as low as 38%. We publicly release the dataset, models, and codebase at https://github.com/KamyarZeinalipour/MultiHint-9K. © 2026 Copyright for this paper by its authors.},
	author_keywords = {Hint Generation; Human-AI Agency; Intelligent Tutoring; Multi-Agent Systems; Pedagogical Scaffolding},
	keywords = {Autonomous agents; Computer aided instruction; Intelligent agents; Open systems; Pipelines; Scaffolds; High-fidelity; Hint generation; Human-AI agency; Intelligent tutoring; Language model; Multiagent systems (MASs); Pedagogical scaffolding; Personalized learning; Quality standard; Yield rates; Multi agent systems},
