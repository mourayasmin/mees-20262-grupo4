@CONFERENCE{Viswambharan2026,
	author = {Viswambharan, Vaisakh Naduvodi and Dileep, Ayush},
	title = {SaxoFlow: An Agentic AI Platform for Hardware Design Research and Education},
	year = {2026},
	journal = {2026 22nd International Conference on Synthesis, Modeling, Analysis and Simulation Methods, and Applications to Circuits Design, SMACD 2026},
	pages = {},
	doi = {10.1109/SMACD70206.2026.11647794},
	url = {https://www.scopus.com/pages/publications/105048639404?origin=resultslist},
	affiliations = {Technische Universität, Dresden, Germany},
	abstract = {Open-source Electronic Design Automation (EDA) tools support major stages of the digital-design flow, but their effective use in teaching, learning, and research remains fragmented across environment setup procedures, tool-specific command interfaces, project conventions, and disconnected tutorial resources. This fragmentation creates high entry barriers for learners, limits how instructors prepare and deliver structured reusable teaching material, and forces researchers to assemble ad hoc workflows for rapid experimentation. This paper presents SaxoFlow, a unified platform for learning, tutoring, and research in open-source hardware design. SaxoFlow integrates deterministic environment setup, diagnostics, project scaffolding, consistent command execution, executable teaching packs, and a documentgrounded AI tutoring and assistance layer within a common run-Time. Within this unified setting, instructors can transform teaching material into structured guided learning flows, learners can engage in context-Aware stepwise study grounded in instructor-provided documents and actual tool behavior, and researchers can conduct rapid, reproducible, multi-Tool experimentation with agentic AI support under real execution constraints. SaxoFlow therefore establishes a shared platform for knowledge transfer, guided practice, and practical experimentation in digital design, rather than treating tutoring, learning, and research workflows as isolated activities.  © 2026 IEEE.},
	author_keywords = {Agentic AI; Hardware Design; LLMs; Open-Source EDA},
