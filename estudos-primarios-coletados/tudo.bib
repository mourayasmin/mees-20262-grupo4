@CONFERENCE{Reddy2025292,
	author = {Reddy, Pavan},
	title = {Weaponizing Words: Direct & Indirect Prompt Injection Attacks on LLM},
	year = {2025},
	journal = {ACM SIGCITE 2025 - Proceedings of the 26th ACM Annual Conference on Cybersecurity and Information Technology Education},
	pages = {292 - 293},
	doi = {10.1145/3769694.3771165},
	url = {https://www.scopus.com/pages/publications/105028686616?origin=resultslist},
	affiliations = {George Washington University, Washington, DC, United States},
	abstract = {As AI systems - particularly LLM applications - proliferate across products and workflows, security has not kept pace. Prompt injection is the failure mode most likely to turn well-intentioned LLM applications into unsafe systems [4]. This 75-minute, code-first tutorial focuses exclusively on the two forms that matter in practice: direct injection through trusted input channels and indirect injection via retrieved or linked content. Using two reproducible demos - EmailGPT (direct) and EchoLeak (indirect) - participants will reproduce end-to-end attacks that override system instructions, exfiltrate secrets, and trigger unauthorized actions, then harden the pipelines step by step. Labs run on free notebooks with small open models and mock tools; no API keys required. We distill why guardrails and "better prompts"alone are insufficient - instruction-following bias, collapsed trust boundaries, and tool autopilot - and build a deployable defense-in-depth stack: input canonicalization, instruction/data separation, untrusted-context labeling, structured I/O contracts, provenance and taint tracking, deny-by-default tool policies, and red-team regression tests. Attendees leave with working intuition, tested code, and a practical checklist they can drop into RAG flows, agents, and email assistants the same day.  © 2025 Copyright held by the owner/author(s).},
	keywords = {Application programming interfaces (API); Codes (symbols); Human engineering; Labeling; Network security; AI systems; Canonicalization; Data separation; End to end; Indirect injections; Input channels; Labelings; Most likely; Regression tests; Work-flows; Electronic mail},
