	author = {Cheng, Wenwen and Guo, Jiahui and Lu, Duwen},
	title = {CHATWELL: an AI-enabled adaptive tutoring system for improving mandarin composition skills in L2 students with learning difficulties},
	year = {2025},
	journal = {Disability and Rehabilitation: Assistive Technology},
	volume = {20},
	number = {7},
	pages = {2358 - 2374},
