@CONFERENCE{Zheng2026240,
	author = {Zheng, Yingying and Luo, Yong and Shan, Yunyan and Lan, Zhuobin},
	title = {A Cognitive Load Theory-Based Study on the Impact Mechanisms of Generative AI Application Patterns on Learning Engagement: Metacognitive Regulation and Disciplinary Differences from a Science and Engineering Perspective},
	year = {2026},
	journal = {Proceedings of the 2nd International Conference on Smart City and Sustainable Development, SCSD 2026},
