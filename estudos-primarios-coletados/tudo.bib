	affiliations = {North South University, Department Of Electrical And Computer Engineering, Dhaka, Bangladesh; Qassim University, Department Of Computer Engineering, Buraydah, Saudi Arabia},
	abstract = {The integration of Agentic AI in educational settings offers unprecedented opportunities for personalized learning. This study explores the concept of Twin Minds by employing Large Language Models as Cognitive Digital Twins of computer programming students. We propose a multi-agent framework where an Agentic Tutor interacts autonomously with a simulated Student Twin. To evaluate pedagogical strategies and behavioral resistance in a simulated environment, we conducted an exploratory dual ablation study. First, we compared a Socratic Tutor against a baseline Direct Tutor. Second, we evaluated the framework across two distinct student personas: a receptive Novice Student and a resistant Stubborn Student. An automated LLM Judge verified code correctness across 30 tasks divided into Foundational and Advanced Algorithmic tiers. The Socratic Tutor achieved an 85.00% success rate on foundational tasks and 100.00% on advanced tasks for the receptive novice. In contrast, providing direct code caused integration failures, dropping foundational success to 40.00%. Furthermore, our behavioral ablation reveals a preliminary observation we term "alignment override,"where instruction-tuned LLMs tend to abandon negative personas when presented with logical hints. This research contributes exploratory insights into multi-agent pedagogical modeling. The findings highlight the need for further research into developing scalable, resilient AI tutoring systems capable of maintaining educational integrity against uncooperative learner behaviors.  © 2026 IEEE.},
	author_keywords = {Adaptive Learning; Agentic AI; Digital Twins; Explainable AI; Multi-Agent Systems; Socratic Tutoring},
