@CONFERENCE{Tu2026490,
	author = {Tu, Xicheng},
	title = {MathPedaCoT: Pedagogy-Aligned Chain-of-Thought Reasoning with Process Supervision and Dual-Agent Verification for LLM-Based Mathematics Education},
	year = {2026},
	journal = {Proceedings of 2026 6th International Conference on Applied Mathematics, Modelling and Intelligent Computing, CAMMIC 2026},
	pages = {490 - 495},
	doi = {10.1145/3817124.3817200},
	url = {https://www.scopus.com/pages/publications/105049681713?origin=resultslist},
	affiliations = {College of Mathematics and Physics, Shanghai Normal University, Shanghai, China},
	abstract = {Large Language Models (LLMs) have demonstrated remarkable potential for AI-driven mathematics education, enabling automated problem-solving, personalised tutoring, and scalable assessment at unprecedented scale. However, deploying LLMs reliably in pedagogical contexts remains challenging due to three critical limitations: (1) progressive accuracy degradation along deep reasoning chains, where step-level correctness drops sharply beyond the third inference step and undermines multi-step mathematical derivations; (2) dominance of procedural-slip errors, which account for over 40% of all solution failures across arithmetic, algebra, and number theory tasks, yet receive no targeted remediation in standard fine-tuning pipelines; and (3) systematic underperformance on calculation accuracy, the weakest dimension across all evaluated models under the Structured Chain-of-Thought (SCoT) assessment framework. To address these limitations simultaneously, we propose MathPedaCoT, a Mathematics Pedagogy Chain-of-Thought framework built on three tightly coupled modules: (1) Process-Supervised Chain-of-Thought Scaffolding (PSCS), which injects step-level process rewards to suppress deep-chain degradation; (2) Error-Type-Aware Pedagogical Feedback (EAPF), which classifies each erroneous step into one of four categories and generates category-specific remediation hints; and (3) Dual-Agent Verification and Correction (DAVC), which employs an independent verifier to detect and correct calculation errors through a propose-verify-correct loop. Extensive experiments on GSM8K, MATH500, and MIT-OCW demonstrate that MathPedaCoT achieves state-of-the-art performance across all benchmarks, with accuracy gains of up to +16.2% on the hardest dataset and a +12.1% improvement in calculation accuracy over the strongest baseline, validating both the educational effectiveness and the technical superiority of our approach.  © 2026 Copyright held by the owner/author(s).},
	author_keywords = {chain-of-thought reasoning; large language models; mathematics education; multi-agent verification; pedagogical feedback; process supervision; step-level error analysis},
	keywords = {Benchmarking; Chains; Computational methods; Computer aided instruction; Education computing; Error analysis; Feedback; Multi agent systems; Number theory; Process control; Teaching; Calculation accuracy; Chain-of-thought reasoning; Language model; Large language model; Mathematics education; Multi agent; Multi-agent verification; Pedagogical feedback; Process supervision; Step-level error analyze; Systematic errors},
	correspondence_address = {X. Tu; College of Mathematics and Physics, Shanghai Normal University, Shanghai, China; email: 18217721229@163.com},
	publisher = {Association for Computing Machinery, Inc},
	isbn = {979-840072329-2},
	language = {English},
