	keywords = {Artificial intelligence; Collaborative learning; Computer aided instruction; Education computing; Ethical technology; Human computer interaction; Adaptive support; AI in education; Collaborative agents; Collaborative learning; Comparative analyzes; Educational environment; Empathy modeling; Generative AI; Inclusivity; Learning scenarios; Intelligent agents},
