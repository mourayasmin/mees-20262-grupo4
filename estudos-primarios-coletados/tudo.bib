	title = {Educational Chatbot-Supported Academic Writing in Higher Education: A Rapid Systematic Review; [Escriptura acadèmica amb el suport de xatbots educatius a l’educació superior: una revisió sistemàtica ràpida]; [Escritura académica apoyada por chatbots educativos en la educación superior: una revisión sistemática rápida]},
	year = {2026},
	journal = {Revista de Educacion y Derecho},
	number = {34},
	pages = {},
	doi = {10.1344/REYD2026.34.56975},
	url = {https://www.scopus.com/pages/publications/105054445604?origin=resultslist},
	affiliations = {Department of English, SR University, Warangal, India; Department of Humanities and Social Science, National Institute of Technology Warangal, India},
	abstract = {In higher education, AI-driven educational chatbots are transforming academic writing by providing immediate feedback, personalized guidance, and opportunities for iterative revision. Although empirical studies report promising outcomes, evidence remains fragmented across academic writing, self-regulated learning (SRL), learner engagement, AI literacy, prompt literacy, and instructional design. This rapid systematic review synthesizes recent empirical evidence to identify the pedagogical mechanisms underpinning effective educational chatbot-supported academic writing. Following the PRISMA 2020 guidelines, 13 empirical studies published between 2025 and 2026 were identified and appraised using the Mixed Methods Appraisal Tool (MMAT). Owing to methodlogical diversity, findings were synthesized through thematic narrative analysis. The review found that educational chatbots function primarily as pedagogical scaffolds rather than standalone writing systems. They enhanced writing quality, planning, revision, learner engagement, SRL, self-efficacy, AI literacy, feedback utilization, and reflective writing. Prompt literacy emerged as a metacognitive competence fostered through teacher mediation, structured prompting, iterative feedback, and instructional scaffolding. However, challenges included AI hallucinations, academic integrity concerns, learner overreliance on AI, and limited longitudinal evidence. The review proposes an Educational chatbot-supported academic writing framework and provides evidence-informed recommendations for pedagogy, institutional policy, and future research on the responsible integration of generative AI in higher education. © This work is licensed under a Creative Commons Attribution 4.0 International License.},
	author_keywords = {Academic writing; aprendizaje autorregulado; aprenentatge autoregulat; chatbots educativos; competencia para formular instrucciones; competència per formular instruccions; educació superior; educación superior; Educational chatbots; escriptura acadèmica; escritura académica; Generative artificial intelligence; Higher education; inteligencia artificial generativa; intel·ligència artificial generativa; Prompt literacy; Rapid systematic review; revisió sistemàtica ràpida; revisión sistemática rápida; Self-regulated learning; xatbots educatius},
