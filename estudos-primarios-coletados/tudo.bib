@CONFERENCE{Crocetti2026119,
	author = {Crocetti, Giancarlo and Iandoli, Luca},
	title = {The Role of AI Tutoring in Enhancing Learning Outcomes for At-Risk Students: A Universal Design for Learning Perspective},
	year = {2026},
	journal = {2026 12th International Conference on Education and Training Technologies, ICETT 2026},
	pages = {119 - 123},
	doi = {10.1109/ICETT70124.2026.11666019},
	url = {https://www.scopus.com/pages/publications/105049611581?origin=resultslist},
	affiliations = {St. John's University, Department of Computer Science and Mathematics, New York, United States},
	abstract = {This paper presents CIRO (Conversational Intelligence for Retention Optimization), an AI-driven tutoring system designed to support at-risk students in higher education through the principles of Universal Design for Learning (UDL), Vygotsky's Zone of Proximal Development (ZPD), and Generative Learning Theory. Leveraging recent advances in Generative AI and Explainable AI, CIRO delivers adaptive, multimodal support tailored to diverse learner needs. The study employs a Design Science Research (DSR) methodology, presenting the artifact design and architecture along with a planned, controlled evaluation. As a design-focused contribution within the DSR tradition, this paper emphasizes the theoretical grounding and system architecture, with empirical validation constituting future work. CIRO integrates large language models with conversational state tracking to scaffold learning and monitor engagement. Ethical oversight and equity compliance are ensured through human-in-the-loop mechanisms. The contribution is twofold: (1) a validated architecture for UDL-aligned AI tutoring and (2) a framework for evaluating GenAI's role in promoting academic equity. This work advances inclusive AI learning environments and offers a scalable model for responsible educational innovation. © 2026 IEEE.},
	author_keywords = {AI Tutoring; At-Risk Students; Design Science Research; Educational Equity; Generative AI; Universal Design for Learning; Zone of Proximal Development},
	keywords = {Architecture; Artificial intelligence; Computer aided instruction; Computer architecture; Education computing; Engineering research; Learning systems; Product design; Teaching; AI tutoring; At-risk student; Design-science researches; Educational equity; Generative AI; Learning outcome; Optimisations; Universal Design; Universal design for learning; Zone of proximal development; Students},
