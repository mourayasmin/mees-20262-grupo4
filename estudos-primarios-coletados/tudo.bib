@CONFERENCE{Nguyen2026,
	author = {Nguyen, Quan and Puthiyedth, Nisha},
	title = {Beyond answers: How a pedagogy-driven AI encourages students to think and learn in Computing Education},
	year = {2026},
	journal = {WCCCE 2026 - Proceedings of the 28th Western Canadian Conference on Computing Education},
	pages = {},
	doi = {10.1145/3828792.3828795},
	url = {https://www.scopus.com/pages/publications/105052616320?origin=resultslist},
	affiliations = {Thompson Rivers University, Kamloops, BC, Canada},
	abstract = {In computer science, generative AI tools present significant opportunities to enhance the learning experience, such as providing personalized feedback, debugging assistance, and contextual hints. However, they also introduce challenges, particularly the risk of students becoming over-reliant on these technologies. This over-reliance can hinder the development of fundamental problem-solving skills and critical thinking, as students may bypass the essential "productive struggle"required for meaningful learning. For instance, students can now copy and paste assignments into general AI tools and receive answers in seconds, completely missing the opportunity to grapple with problems and develop their own solutions. To address this challenge, we developed TRU-Think, a pedagogy-driven AI extension for Visual Studio Code that encourages students to think critically, practice coding, and reinforce learning. Built on GitHub Copilot, TRU-Think provides interactive scaffolding instead of direct answers. It features four distinct modes: (1) General Mode for programming-related questions, (2) Concept Review Mode for theoretical explanations, (3) Coding Practice Mode for hands-on learning with guided hints, and (4) Exam Practice Mode for assessment preparation. By integrating seamlessly into students' coding environments, TRU-Think minimizes context-switching and enhances engagement. A pilot study conducted in a Fall 2025 on two computing courses (Python programming, and Database) at Thompson Riveres University demonstrated the tool's effectiveness in promoting cognitive engagement. By requiring students to explain logic in their own words and write pseudocode before receiving technical feedback, the assistant reinforces the learning process while living directly where students code to reduce context-switching. This work demonstrates how AI-powered tutoring can be designed to support - not replace - students' learning processes. © 2026 Copyright held by the owner/author(s).},
	author_keywords = {AI system design; artificial intelligence; computing education; productive struggle},
	keywords = {Codes (symbols); Computer aided instruction; Curricula; E-learning; Education computing; Engineering education; Feedback; Human engineering; Interactive computer graphics; Learning systems; Software engineering; Students; Teaching; Visual languages; AI system design; AI systems; Computing education; Context switching; Learn+; Learning experiences; Over reliance; Personalized feedback; Problem solving skills; Productive struggle; Artificial intelligence},
	correspondence_address = {Q. Nguyen; Thompson Rivers University, Kamloops, Canada; email: lnguyen@tru.ca},
