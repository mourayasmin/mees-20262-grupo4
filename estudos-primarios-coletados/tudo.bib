@CONFERENCE{Techadisai2026,
	author = {Techadisai, Kantima and Sirinaovakul, Booncharoen},
	title = {Modelfile Engineering for Offline B2 English Tutoring},
	year = {2026},
	journal = {IAIT 2026 - 14th International Conference on Advances in Information Technology},
	pages = {},
	doi = {10.1145/3816713.3819514},
	url = {https://www.scopus.com/pages/publications/105045285927?origin=resultslist},
	affiliations = {King Mongkut’s University of Technology Thonburi, Thungkru, Bangkok, Thailand},
	abstract = {Current AI language tutors face critical limitations in Thai educational contexts: cloud dependency (raising privacy concerns), feedback exceeding B2 learners' cognitive capacity, and punitive treatment of Thai-English code-switching-a natural scaffolding strategy. We propose Modelfile Engineering, a lightweight method to embed CEFR B2 pedagogical constraints directly into Ollama's Modelfile without full retraining. Our framework enforces A2-B2 vocabulary, uses structured visual feedback, integrates few-shot grammar examples, and treats code-switching as a learning opportunity. Evaluated on a 350-item test set (including 50 Thai-English inputs), it achieves 93.3% grammar error detection accuracy and 96.7% CEFR compliance. Human evaluation confirms strong structural consistency (90.5%) and culturally appropriate L1 handling. Operating offline on consumer hardware (1.8 GB), our solution offers a reproducible, privacy-preserving approach for resource-constrained settings in Southeast Asia.  © 2026 Copyright held by the owner/author(s).},
