@ARTICLE{Conradty20261,
	author = {Conradty, Cathérine and Sotiriou, Sofoklis Alexander and Koulentianos, Dimitris and Bogner, Franz Xaver},
	title = {Students' conceptions about AI in science classrooms},
	year = {2026},
	journal = {Frontiers in Education},
	volume = {11},
	pages = {1 - 13},
