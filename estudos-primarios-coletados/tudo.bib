	title = {ReFashionPal: Exploring AI Assistant Embedded in How-to Videos to Support Garment Repurposing},
	year = {2026},
	journal = {Conference on Human Factors in Computing Systems - Proceedings },
	pages = {},
	doi = {10.1145/3772363.3798775},
