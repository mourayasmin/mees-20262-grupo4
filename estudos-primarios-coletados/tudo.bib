@CONFERENCE{Daniels2025209,
	author = {Daniels, Matthew},
	title = {AI-powered game-based learning for project management education},
	year = {2025},
	journal = {Proceedings of the European Conference on Games-based Learning},
	volume = {19},
	number = {1},
	pages = {209 - 216},
	doi = {10.34190/ecgbl.19.1.4203},
	url = {https://www.scopus.com/pages/publications/105030157381?origin=resultslist},
	affiliations = {Kemmy Business School, University of Limerick, Ireland},
	abstract = {Bridging the gap between theory and practice remains a core challenge in project management education, as students often struggle to transfer classroom knowledge into complex, uncertain, and ethically charged environments. As serious games increasingly integrate artificial intelligence (AI), new opportunities arise for scalable, adaptive, and ethically informed learning. This paper introduces and evaluates an AI-enhanced Game-Based Learning (AI-GBL) framework that positions AI as a pedagogical co-orchestrator modulating narrative and challenge rather than a content add-on. It embeds serious game mechanics through two interactive modalities: AI-driven stakeholder interviews and collaborative crisis scenarios requiring students to make decisions, weigh trade-offs, and reflect on consequences. Structured debriefs and ethically ambiguous dilemmas reinforced reflection, judgment, and leadership identity. Within this framework, the lecturer served as a game master, shaping the environment, guiding discussion, and ensuring ethical engagement, while AI dynamically adapted gameplay. Grounded in Kolb's experiential learning cycle and scaffolded by the 5E model, the design also drew on Self-Determination Theory and Flow to support autonomy, competence, and engagement. A mixed-methods, quasi-experimental pretest posttest design was applied in live classrooms. Undergraduates (n = 113) were grouped by tutorial exposure (experimental: ≥3, n = 66; control: ≤2, n = 47), while a postgraduate cohort (n = 47) contributed qualitative reflections. Students in the AI-GBL group achieved significantly higher posttest scores (means: 66.64 vs. 48.00). ANCOVA controlling for pretest confirmed a large effect (partial n<sup>2</sup>= .799), though this should be interpreted cautiously due to the non-randomised design. Qualitative reflections revealed growth in ethical reasoning, collaborative identity, and adaptive decision-making, alongside signs of over-reliance on AI highlighting the need for scaffolding in ethical AI literacy. Findings suggest that AI-GBL can enhance domain-specific performance and the metacognitive and affective dimensions of adaptive expertise ethical sensitivity, reflective judgment, and leadership identity. Three design principles emerge: (1) AI should function as a co-orchestrator, modulating challenge and feedback in real time; (2) open-ended, ethically complex scenarios deepen reflection beyond procedural accuracy; and (3) critical scaffolding is essential to prevent passive reliance on AI-generated outputs. This study builds on prior conceptual work published in Project Leadership and Society by providing empirical evidence of AI-GBL's effectiveness, advancing design principles for AI-integrated serious games, and identifying directions for future research, including longitudinal tracking, replication, and cross-domain application. © 2025 Dechema e.V.. All rights reserved.},
	author_keywords = {Experiential learning; Game-Based learning; Generative AI; Project management education; Serious games},
	keywords = {Artificial intelligence; Collaborative learning; Decision making; Economic and social effects; Education computing; Ethical technology; Learning systems; Project management; Students; Teaching; Design Principles; Experiential learning; Game masters; Game-based Learning; Gameplay; Generative artificial intelligence; Learning frameworks; Project management education; Theory and practice; Trade off; Serious games},
