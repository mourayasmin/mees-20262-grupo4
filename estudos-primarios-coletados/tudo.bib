@ARTICLE{Li2025,
	author = {Li, Ruijia and Jiang, Yuan-Hao and Wang, Jiatong and Jiang, Bo},
	title = {How Real Is AI Tutoring? Comparing Simulated and Human Dialogues in One-on-One Instruction},
	year = {2025},
	journal = {Proceedings of the International Conference on Computers in Education},
	volume = {4},
	pages = {},
	url = {https://www.scopus.com/pages/publications/105046207816?origin=resultslist},
	affiliations = {Shanghai Institute of Artificial Intelligence for Education, East China Normal University, Shanghai, China; Lab of Artificial Intelligence for Education, East China Normal University, Shanghai, China},
	abstract = {Heuristic and scaffolded teacher-student dialogues are widely regarded as critical for fostering students' higher-order thinking and deep learning. However, large language models (LLMs) currently face challenges in generating pedagogically rich interactions. This study systematically investigates the structural and behavioral differences between AI-simulated and authentic human tutoring dialogues. We conducted a quantitative comparison using an Initiation-Response-Feedback (IRF) coding scheme and Epistemic Network Analysis (ENA). The results show that human dialogues are significantly superior to their AI counterparts in utterance length, as well as in questioning (I-Q) and general feedback (F-F) behaviors. More importantly, ENA results reveal a fundamental divergence in interactional patterns: human dialogues are more cognitively guided and diverse, centered around a "question-factual response-feedback" teaching loop that clearly reflects pedagogical guidance and student-driven thinking; in contrast, simulated dialogues exhibit a pattern of structural simplification and behavioral convergence, revolving around an "explanation-simplistic response" loop that is essentially a simple information transfer between the teacher and student. These findings illuminate key limitations in current AI-generated tutoring and provide empirical guidance for designing and evaluating more pedagogically effective generative educational dialogue systems. © 2026 IEEE.},
	author_keywords = {dialogue structure analysis; epistemic network analysis; initiation–response–feedback coding; Large language model; simulated teacher-student dialogue},
