@CONFERENCE{Klefstad2026,
	author = {Klefstad, Bjorn and Sandstrak, Grethe and Styve, Arne G. and Raja, Kiran},
	title = {On Using Programming-RAG to Improve Learning Outcomes in Programming Education},
	year = {2026},
	journal = {IEEE Global Engineering Education Conference, EDUCON},
	pages = {},
	doi = {10.1109/EDUCON67543.2026.11574292},
	url = {https://www.scopus.com/pages/publications/105044395130?origin=resultslist},
	affiliations = {Norwegian University Of Science And Technology, Department Of Computer Science, Norway; Norwegian University Of Science And Technology, Department Of Ict And Natural Sciences, Norway},
	abstract = {The integration of generative artificial intelligence (AI), particularly large language models (LLMs), is reshaping educational practices across disciplines. In computer science education, these models offer new avenues to support novice learners beyond traditional resources. This study investigates the pedagogical impact of Retrieval-Augmented Generation (RAG) agents in introductory programming courses. The RAG-agent is combining generative capabilities with real-time access to documentation, examples, and community-driven knowledge. Specifically a customized Programming-RAG-agent (PRAG-agent) offer adaptive, context-sensitive tutoring aligned with learners' immediate needs. Using a mixed-methods research design, we analyze solutions for programming tasks from students across two settings: with and without the use of a PRAG-agent. Quantitative metrics include low coupling and high cohesion, robust code (fail-safe code), defensive programming, documentation according to JavaDoc standards and Web-compatible documentation. Qualitative data encompasses student reflections on the usefulness of the PRAG-agent, and how the PRAG-agent should be developed for future use. A scaffolding model guides the evaluation of the PRAG-agent support across stages of learning: initial understanding, guided practice, and independent problem-solving. Findings suggest that the PRAG-agent enhances learning outcomes, fosters self-directed learning, and supports practices for good code quality; however, students did not perceive these improvements, revealing a contradiction between measured results and self-reported experiences. For educators, PRAG-agents facilitate a shift from content delivery to AI-supported guidance, offering insights into redefined teaching methodologies. © 2026 IEEE.},
	author_keywords = {Artificial Intelligence (AI); Educational Applications; Large Language Models (LLMs); Retrieval-Augmented Generation (RAG)},
	keywords = {Artificial intelligence; Computer aided instruction; Computer programming languages; Curricula; E-learning; Education computing; Engineering education; Learning systems; Students; Systems analysis; Teaching; Artificial intelligence; Computer Science Education; Educational Applications; Introductory programming course; Language model; Large language model; Learning outcome; Programming education; Real-time access; Retrieval-augmented generation; Codes (symbols)},
