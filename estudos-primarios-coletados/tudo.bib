@ARTICLE{Kudina2025,
	author = {Kudina, Olya and Ballsun-Stanton, Brian and Alfano, Mark},
	title = {The use of large language models as scaffolds for proleptic reasoning},
	year = {2025},
	journal = {Asian Journal of Philosophy},
	volume = {4},
