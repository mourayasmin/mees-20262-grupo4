@CONFERENCE{Friesinger2026,
	author = {Friesinger, Elisabeth and Bassner, Patrick and Krusche, Stephan},
	title = {How AI Structures Access to Help: Gender Differences in AI-Supported Programming Education},
	year = {2026},
	journal = {2026 22nd International Conference on Information Technology Based Higher Education and Training, ITHET 2026},
	pages = {},
