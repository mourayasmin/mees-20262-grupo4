@CONFERENCE{Xu2026,
	author = {Xu, Qingyang},
	title = {FairTutor: Equity-Aware Pedagogical LLM Routing for Budget-Constrained AI Tutoring},
	year = {2026},
	journal = {CEUR Workshop Proceedings},
	volume = {4277},
