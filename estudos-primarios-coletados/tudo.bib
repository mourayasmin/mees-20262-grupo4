@ARTICLE{Nasirun2026,
	author = {Nasirun, Hafizs and Mulyono, Sigit and Hapsari, Ayu Widowati Dwi and Wiradinata, Hendri Hardi and Ratu, Mustika},
	title = {Generative AI and intelligent tutoring systems in nursing education: A systematic review of impacts on higher-order thinking skills and clinical competency},
	year = {2026},
	journal = {Nurse Education in Practice},
	volume = {93},
	pages = {},
	doi = {10.1016/j.nepr.2026.104847},
	url = {https://www.scopus.com/pages/publications/105037482584?origin=resultslist},
	affiliations = {Faculty of Nursing, Universitas Indonesia, West Java, Depok, Indonesia; Department of Community Nursing, Faculty of Nursing, Universitas Indonesia, West Java, Depok, Indonesia; Faculty of Mathematics and Natural Sciences, Universitas Indonesia, West Java, Depok, Indonesia},
	abstract = {Aims: This review synthesizes the impact of Artificial Intelligence (AI) on nursing students' clinical competency, Higher-Order Thinking Skills (HOTS) and educational outcomes to differentiate between procedural efficiency and deep cognitive retention. Background: Generative AI and Intelligent Tutoring Systems (ITS) offer personalized scaffolding. However, their comparative efficacy against conventional pedagogical approaches, such as face-to-face lectures and standard non-AI simulations, remains controversial, particularly regarding the potential trade-off between skill acquisition and cognitive depth. Design: A systematic literature review guided by PRISMA 2020 guidelines. Methods: A comprehensive search across seven databases (PubMed, EBSCOhost, Scopus, ScienceDirect, ProQuest, IEEE Xplore, JSTOR) from 2015 to 2025 identified 14 eligible studies (7 RCTs, 7 Quasi-experiments) which were synthesized across East Asia, Europe and Africa. Quality was appraised using JBI tools, with the protocol registered in PROSPERO. Results: Synthesis of 14 studies (n = 1107) reveals a critical divergence. AI interventions significantly improved psychomotor application, procedural skills and communication mechanics compared with traditional instructor-led teaching methods. However, findings on HOTS and retention were mixed; while GenAI enhanced inquiry-based problem solving, it occasionally compromised critical reflection and long-term knowledge retention compared with human-led instruction. Furthermore, a “gap in algorithmic empathy” was evident, with AI failing to effectively enhance cultural awareness. Conclusion: AI functions as a robust “pedagogical scaffold” for procedural simulation but risks inducing “cognitive offloading” if used passively. Educators must adopt a Hybrid-Scaffolded Model: leveraging AI for iterative drills while prioritizing human facilitation for deep cognitive consolidation, ethics and cultural safety. © 2026 Elsevier Ltd},
	author_keywords = {Artificial Intelligence; Clinical Competence; Generative AI; Higher-Order Thinking Skills; Nursing Education; Simulation},
	keywords = {Artificial Intelligence; Clinical Competence; Education, Nursing; Generative Artificial Intelligence; Humans; Intelligent Systems; Students, Nursing; Thinking; artificial intelligence; awareness; ChatGPT; clinical competence; clinical practice guideline; cognition; cultural safety; data extraction; decision making; educational technology; generative artificial intelligence; human; intelligent tutoring system; knowledge; machine learning; meta analysis; nursing education; nursing student; outcome assessment; practice guideline; Preferred Reporting Items for Systematic Reviews and Meta-Analyses; problem solving; quantitative analysis; questionnaire; randomized controlled trial (topic); reproducibility; review; Review; skill; systematic review; teaching; thinking; artificial intelligence; generative artificial intelligence; nursing student; procedures; psychology; smart device; thinking},
