@ARTICLE{Paredes-Cayllahua202639,
	author = {Paredes-Cayllahua, Eloisa L.},
	title = {Pedagogical Prompt Engineering Patterns: A Vygotskian Approach to adaptive Scaffolding in Computing Education with LLMs; [Patrones de ingeniería de prompts con fines pedagógicos: un enfoque vygotskiano para el andamiaje adaptativo en la enseñanza de la informática mediante modelos de lenguaje de gran tamaño (LLM)]},
	year = {2026},
