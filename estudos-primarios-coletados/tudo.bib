@ARTICLE{Perez2026,
	author = {Perez, Ryann M. and Shimogawa, Marie and Chang, Yanan and Li, Xinning and Phan, Hoang Anh T. and Marmorstein, Jason G. and Yanagawa, Evan S.K. and Petersson, E. James},
	title = {Large language models for education: An open-source paradigm for automated Q&A in the graduate classroom},
	year = {2026},
	journal = {Computers and Education: Artificial Intelligence},
	volume = {10},
	pages = {},
	doi = {10.1016/j.caeai.2026.100546},
	url = {https://www.scopus.com/pages/publications/105027729871?origin=resultslist},
	affiliations = {Department of Chemistry, University of Pennsylvania, Philadelphia, 19104, PA, United States},
	abstract = {Large Language Models (LLMs) offer scalable educational support, but face barriers regarding accuracy, cost, and learning depth. To interrogate these limitations, we developed the Teaching Assistant for Specialized Knowledge (TAsk), a retrieval-augmented generation enabled and educator curated pipeline. In this nine-week pilot study (N = 33 participants), we deployed TAsk in a graduate-level biological chemistry course. We compared TAsk against human expert teaching assistants (TAs) using blinded review process and analyzed inquiry depth. We observed three major findings related to potential pedagogical decisions and educational theory. First, TAsk delivered effective feedback that was specific and adaptive as it significantly outperformed expert TAs in overall correctness. However, human TAs remained superior in tailoring responses to course nuances. Second, behavioral analysis based on educational scaffolding techniques, such as Bloom's Taxonomy and the Zone of Proximal Development (ZPD), identified a cognitive bypass risk where frequent users submitted significantly fewer higher-order queries compared to infrequent users. Third, benchmarking demonstrated that smaller models could approach frontier model performance when optimized, suggesting future costs can be reduced significantly for TAsk in the pilot study. Finally, we validated a confabulation detection algorithm, hypothesizing that this algorithm could help students calibrate trust in model outputs in future iterations of TAsk. Taken together, these contributions establish TAsk as a validated framework for higher education learning while highlighting the critical need for pedagogical scaffolding for LLMs. © 2026 The Authors.},
	author_keywords = {Confabulation safeguards; Educational technology; Large language models; Retrieval-augmented generation; Scaffolding},
	keywords = {Behavioral research; Benchmarking; Computation theory; Computational methods; Curricula; Educational technology; Engineering education; Scaffolds (biology); Students; Teaching; Confabulation safeguard; Graduate-level; Language model; Large language model; Open source paradigm; Pilot studies; Retrieval-augmented generation; Scaffolding; Specialized knowledge; Teaching assistants; Scaffolds},
	correspondence_address = {R.M. Perez; Department of Chemistry, University of Pennsylvania, Philadelphia, 19104, United States; email: ryper@sas.upenn.edu; E.J. Petersson; Department of Chemistry, University of Pennsylvania, Philadelphia, 19104, United States; email: ejpetersson@sas.upenn.edu},
